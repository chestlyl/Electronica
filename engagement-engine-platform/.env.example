# =============================================================================
# The Engagement Engine — Environment Variables
#
# Copy this file to .env (never commit .env) and fill in real values.
#
# Variables prefixed NEXT_PUBLIC_ or EXPO_PUBLIC_ are exposed to client bundles.
# All other variables must remain server-only.
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public / client-safe
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to client bundles
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct DB connection (server-only, never prefix with NEXT_PUBLIC_)
DATABASE_URL=******127.0.0.1:54322/postgres

# ── Application URLs ─────────────────────────────────────────────────────────
# Public (may be referenced in emails, redirects)
NEXT_PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_CHURCH_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_PUBLIC_WEB_URL=http://localhost:3002
NEXT_PUBLIC_MEMBER_WEB_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:4000

# Internal / server-only
API_URL=http://localhost:4000

# ── API ───────────────────────────────────────────────────────────────────────
# Secret used to sign internal API tokens (server-only)
API_SECRET=

# ── Secret management (future) ───────────────────────────────────────────────
# Provider: vault | aws-secrets-manager | gcp-secret-manager | none
SECRET_PROVIDER=none
# VAULT_ADDR=
# VAULT_TOKEN=
# AWS_REGION=
# GCP_PROJECT=

# ── Email provider (future) ──────────────────────────────────────────────────
# Provider: resend | sendgrid | ses | none
EMAIL_PROVIDER=none
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# ── SMS provider (future) ────────────────────────────────────────────────────
# Provider: twilio | none
SMS_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Stripe (future giving platform) ─────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── StudioC integration (future) ─────────────────────────────────────────────
# STUDIOC_API_URL=
# STUDIOC_API_KEY=
